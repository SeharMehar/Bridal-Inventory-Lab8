@page "{id:int}"
@model Lab_8.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Bridal Product";
}

<h1>Delete Bridal Product</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this bridal product?
</div>

<div class="card mb-3" style="max-width:500px">
    <div class="card-body">
        <h4>@Model.BridalProduct.Title</h4>

        @if (!string.IsNullOrEmpty(Model.BridalProduct.Image))
        {
            <img src="@Url.Content("~/" + Model.BridalProduct.Image)"
                 alt="@Model.BridalProduct.Title"
                 style="width:150px;height:150px;object-fit:cover"
                 class="mb-3 rounded border" />
        }

        <p><strong>Price:</strong> Rs. @Model.BridalProduct.Price</p>
        <p><strong>Quantity:</strong> @Model.BridalProduct.Quantity</p>
        <p><strong>Status:</strong> @Model.BridalProduct.Status</p>
    </div>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>